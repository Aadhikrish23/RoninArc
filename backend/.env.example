# RoninArc backend settings. Copy to backend/.env for local development and fill in what you need.
# Never commit backend/.env. Every value here is a placeholder.
#
# The packaged desktop app doesn't read this file: main.js sets the database, port, JWT secret and
# log folder itself, and the game database / AI / Steam keys come from keygate (desktop/keygate.json).
# RoninArc Cloud on Render sets its values in the dashboard (see render.yaml and docs/cloud/DEPLOY.md).

# ---- Server -----------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
# The frontend's address, for CORS (Vite dev server).
ALLOWED_ORIGIN=http://localhost:5173
# Signs access and refresh tokens. Any long random string.
JWT_SECRET=change-me-to-a-long-random-string
# Shown in the API docs and sent with error reports.
APP_VERSION=

# ---- Database ---------------------------------------------------------------------------------
# MONGO_URI wins when set (the desktop app and the cloud use it); LOCAL_URL_Mongo is the dev default.
LOCAL_URL_Mongo=mongodb://localhost:27017/RoninArc
MONGO_URI=

# ---- Logs -------------------------------------------------------------------------------------
# Defaults to backend/logs. App logs are logs/app-<date>.jsonl; AI request logs are logs/ai/<date>/.
LOG_DIR=
LOG_LEVEL=debug
# "json" prints raw JSON lines on stdout instead of readable ones.
LOG_FORMAT=
LOG_RETENTION_DAYS=14
# AI request logs: days kept (defaults to LOG_RETENTION_DAYS) and the folder's size cap in MB.
AI_LOG_RETENTION_DAYS=
AI_LOG_MAX_MB=150

# ---- Error reporting (optional) ---------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
# "false" turns off Sentry's duplicate-event filter (used by the tests).
SENTRY_DEDUPE=

# ---- Game database (IGDB) ---------------------------------------------------------------------
# Either go through keygate (base URL + your token)...
IGDB_BASE_URL=https://api.igdb.com/v4
IGDB_API_KEY=
# ...or straight to IGDB with a Twitch app's credentials (used when IGDB_API_KEY is empty).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Pause between IGDB calls in ms (IGDB allows about 4 a second).
IGDB_CALL_GAP_MS=260

# ---- AI assistant -----------------------------------------------------------------------------
# "nvidia" (NVIDIA NIM) or "ollama" (a local model).
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Comma-separated models tried when the main one is slow or failing.
NVIDIA_FALLBACK_MODELS=
# Timeouts in ms: the whole planning call, the first model before falling back, and the answer call.
NVIDIA_TIMEOUT=30000
NVIDIA_PRIMARY_TIMEOUT=6000
NVIDIA_ANSWER_TIMEOUT=20000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=90000
# "true" replaces the model with the deterministic stand-in the e2e tests use.
MOCK_LLM=
# "true" adds the full context snapshot to AI traces.
DEBUG_AI=

# ---- Steam ------------------------------------------------------------------------------------
# A Steam Web API key (or a keygate token, with STEAM_API_BASE pointing at keygate).
STEAM_API_KEY=
STEAM_API_BASE=https://api.steampowered.com
# Where Steam sends the user back after signing in. Defaults to this server's /provider/steam/oauth/return.
STEAM_RETURN_URL=

# ---- RoninArc Cloud ---------------------------------------------------------------------------
# On a PC: the cloud this backend syncs with.
CLOUD_API_URL=
# On the cloud server itself, "true":
CLOUD_MODE=
# The cloud's public address, for password-reset links (Render sets RENDER_EXTERNAL_URL).
PUBLIC_URL=
# Each account's AI requests per day on the cloud.
AI_DAILY_LIMIT_PER_USER=150
# Multiplies every rate limit (the tests raise it).
RATE_LIMIT_MULTIPLIER=1
# Forgot-password emails (Resend).
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
MAIL_FROM=

# ---- scripts/dev-cloud.cjs (a local cloud for trying the phone app) ---------------------------
CLOUD_PORT=5056
CLOUD_MONGO_URI=mongodb://localhost:27017/RoninArc_cloud_dev

# Set by the desktop app when it starts this backend; don't set by hand.
# ELECTRON_EMBEDDED=1
