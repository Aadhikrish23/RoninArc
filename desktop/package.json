{
  "name": "desktop",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "predist": "node scripts/fetch-mongod.js && npm --prefix ../backend run build && npm --prefix ../frontend run build && node scripts/copy-frontend.js",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.roninarc.launcher",
    "productName": "RoninArc",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "services/**/*",
      "frontend/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "mongodb-bin", "to": "mongodb-bin" },
      { "from": "../backend/dist", "to": "backend/dist" },
      { "from": "../backend/node_modules", "to": "backend/node_modules" },
      { "from": "../backend/package.json", "to": "backend/package.json" }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "axios": "^1.18.1"
  }
}
